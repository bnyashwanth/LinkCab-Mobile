import React, { useState, useRef, useEffect } from 'react';
import {
  View,
  Text,
  TextInput,
  TouchableOpacity,
  StyleSheet,
  Alert,
  KeyboardAvoidingView,
  Platform,
  ScrollView,
  Modal,
  FlatList,
} from 'react-native';
import MapView, { Marker, Region } from 'react-native-maps';
import { useRide } from '@/contexts/RideContext';
import { useLocation } from '@/hooks/useLocation';
import { Button } from '@/components/Button';
import { Input } from '@/components/Input';

interface Location {
  id: string;
  name: string;
  address: string;
  latitude: number;
  longitude: number;
}

const mockLocations: Location[] = [
  { id: '1', name: 'Bangalore Airport', address: 'Kempegowda International Airport', latitude: 13.1986, longitude: 77.7066 },
  { id: '2', name: 'MG Road', address: 'MG Road, Bangalore', latitude: 12.9768, longitude: 77.6033 },
  { id: '3', name: 'Electronic City', address: 'Electronic City, Bangalore', latitude: 12.8399, longitude: 77.6770 },
  { id: '4', name: 'Whitefield', address: 'Whitefield, Bangalore', latitude: 12.9698, longitude: 77.7498 },
  { id: '5', name: 'Indiranagar', address: 'Indiranagar, Bangalore', latitude: 12.9784, longitude: 77.6408 },
];

const cabTypes = [
  { label: 'Sedan', value: 'sedan' },
  { label: 'SUV', value: 'suv' },
  { label: 'Hatchback', value: 'hatchback' },
  { label: 'Auto', value: 'auto' },
];

const genderPreferences = [
  { label: 'No Preference', value: 'any' },
  { label: 'Male Only', value: 'male' },
  { label: 'Female Only', value: 'female' },
];

export default function CreateRideScreen() {
  const [pickupLocation, setPickupLocation] = useState<Location | null>(null);
  const [dropoffLocation, setDropoffLocation] = useState<Location | null>(null);
  const [pickupSearch, setPickupSearch] = useState('');
  const [dropoffSearch, setDropoffSearch] = useState('');
  const [showPickupModal, setShowPickupModal] = useState(false);
  const [showDropoffModal, setShowDropoffModal] = useState(false);
  const [selectedDate, setSelectedDate] = useState('');
  const [selectedTime, setSelectedTime] = useState('');
  const [availableSeats, setAvailableSeats] = useState('1');
  const [cabType, setCabType] = useState('sedan');
  const [genderPreference, setGenderPreference] = useState('any');
  const [notes, setNotes] = useState('');

  const mapRef = useRef<MapView>(null);
  const { createRide, loading } = useRide();
  const { currentLocation } = useLocation();

  useEffect(() => {
    const now = new Date();
    setSelectedDate((prev) => prev || now.toISOString().split('T')[0]);
    const hours = now.getHours();
    const mins = now.getMinutes();
    setSelectedTime((prev) => prev || `${hours.toString().padStart(2, '0')}:${mins.toString().padStart(2, '0')}`);
  }, []);

  const estimateFare = () => {
    if (!pickupLocation || !dropoffLocation) return 0;
    const lat1 = pickupLocation.latitude;
    const lon1 = pickupLocation.longitude;
    const lat2 = dropoffLocation.latitude;
    const lon2 = dropoffLocation.longitude;
    const R = 6371;
    const dLat = ((lat2 - lat1) * Math.PI) / 180;
    const dLon = ((lon2 - lon1) * Math.PI) / 180;
    const a =
      Math.sin(dLat / 2) * Math.sin(dLat / 2) +
      Math.cos((lat1 * Math.PI) / 180) *
        Math.cos((lat2 * Math.PI) / 180) *
        Math.sin(dLon / 2) *
        Math.sin(dLon / 2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1 - a));
    const km = R * c;
    return Math.round(50 + km * 12);
  };

  const filteredPickupLocations = mockLocations.filter(location =>
    location.name.toLowerCase().includes(pickupSearch.toLowerCase()) ||
    location.address.toLowerCase().includes(pickupSearch.toLowerCase())
  );

  const filteredDropoffLocations = mockLocations.filter(location =>
    location.name.toLowerCase().includes(dropoffSearch.toLowerCase()) ||
    location.address.toLowerCase().includes(dropoffSearch.toLowerCase())
  );

  const handleLocationSelect = (location: Location, type: 'pickup' | 'dropoff') => {
    if (type === 'pickup') {
      setPickupLocation(location);
      setPickupSearch(location.name);
      setShowPickupModal(false);
    } else {
      setDropoffLocation(location);
      setDropoffSearch(location.name);
      setShowDropoffModal(false);
    }
  };

  const handleCreateRide = async () => {
    if (!pickupLocation || !dropoffLocation) {
      Alert.alert('Error', 'Please select both pickup and dropoff locations');
      return;
    }

    if (!availableSeats) {
      Alert.alert('Error', 'Please enter available seats');
      return;
    }

    try {
      const { error } = await createRide({
        pickup_location: {
          latitude: pickupLocation.latitude,
          longitude: pickupLocation.longitude,
          address: pickupLocation.address,
        },
        dropoff_location: {
          latitude: dropoffLocation.latitude,
          longitude: dropoffLocation.longitude,
          address: dropoffLocation.address,
        },
        estimated_fare: estimateFare(),
        ride_date: selectedDate,
        ride_time: selectedTime,
        available_seats: parseInt(availableSeats),
        cab_type: cabType,
        gender_preference: genderPreference,
        notes: notes,
      });

      if (error) {
        Alert.alert('Error', error.message || 'Failed to create ride');
        return;
      }

      Alert.alert('Success', 'Ride created successfully!');
      // Reset form
      setPickupLocation(null);
      setDropoffLocation(null);
      setPickupSearch('');
      setDropoffSearch('');
      setSelectedDate('');
      setSelectedTime('');
      setAvailableSeats('1');
      setCabType('sedan');
      setGenderPreference('any');
      setNotes('');
    } catch (error) {
      Alert.alert('Error', 'Failed to create ride');
    }
  };

  const renderLocationItem = (item: Location, type: 'pickup' | 'dropoff') => (
    <TouchableOpacity
      style={styles.locationItem}
      onPress={() => handleLocationSelect(item, type)}
    >
      <View style={styles.locationInfo}>
        <Text style={styles.locationName}>{item.name}</Text>
        <Text style={styles.locationAddress}>{item.address}</Text>
      </View>
      <Text style={styles.selectIcon}>→</Text>
    </TouchableOpacity>
  );

  return (
    <KeyboardAvoidingView style={styles.container} behavior={Platform.OS === 'ios' ? 'padding' : 'height'}>
      <ScrollView style={styles.scrollView} showsVerticalScrollIndicator={false}>
        <View style={styles.content}>
          <Text style={styles.title}>Create a Ride</Text>
          <Text style={styles.subtitle}>Offer a ride to others</Text>

          {/* Location Selection */}
          <View style={styles.section}>
            <Text style={styles.sectionTitle}>Route Details</Text>

            <TouchableOpacity
              style={styles.locationInput}
              onPress={() => setShowPickupModal(true)}
            >
              <Input
                placeholder="From: Pickup Location"
                value={pickupSearch}
                onChangeText={setPickupSearch}
                editable={false}
                style={styles.input}
              />
            </TouchableOpacity>

            <TouchableOpacity
              style={styles.locationInput}
              onPress={() => setShowDropoffModal(true)}
            >
              <Input
                placeholder="To: Dropoff Location"
                value={dropoffSearch}
                onChangeText={setDropoffSearch}
                editable={false}
                style={styles.input}
              />
            </TouchableOpacity>
          </View>

          {/* Date and Time */}
          <View style={styles.section}>
            <Text style={styles.sectionTitle}>When?</Text>

            <View style={styles.dateTimeRow}>
              <Input
                placeholder="Date (YYYY-MM-DD)"
                value={selectedDate}
                onChangeText={setSelectedDate}
                style={styles.halfInput}
              />

              <Input
                placeholder="Time (HH:MM)"
                value={selectedTime}
                onChangeText={setSelectedTime}
                style={styles.halfInput}
              />
            </View>
          </View>

          {/* Ride Preferences */}
          <View style={styles.section}>
            <Text style={styles.sectionTitle}>Ride Preferences</Text>

            <View style={styles.detailsRow}>
              <View style={styles.pickerContainer}>
                <Text style={styles.pickerLabel}>Cab Type</Text>
                <TouchableOpacity
                  style={styles.dropdownButton}
                  onPress={() => {
                    Alert.alert(
                      'Select Cab Type',
                      'Choose your vehicle type',
                      cabTypes.map((type) => ({
                        text: type.label,
                        onPress: () => setCabType(type.value),
                      }))
                    );
                  }}
                >
                  <Text style={styles.dropdownText}>
                    {cabTypes.find(t => t.value === cabType)?.label || 'Sedan'}
                  </Text>
                </TouchableOpacity>
              </View>

              <View style={styles.pickerContainer}>
                <Text style={styles.pickerLabel}>Gender Preference</Text>
                <TouchableOpacity
                  style={styles.dropdownButton}
                  onPress={() => {
                    Alert.alert(
                      'Select Gender Preference',
                      'Choose passenger preference',
                      genderPreferences.map((pref) => ({
                        text: pref.label,
                        onPress: () => setGenderPreference(pref.value),
                      }))
                    );
                  }}
                >
                  <Text style={styles.dropdownText}>
                    {genderPreferences.find(p => p.value === genderPreference)?.label || 'No Preference'}
                  </Text>
                </TouchableOpacity>
              </View>
            </View>

            <View style={styles.seatsContainer}>
              <Text style={styles.pickerLabel}>Maximum Passengers</Text>
              <View style={styles.seatsRow}>
                {[1, 2, 3, 4].map((num) => (
                  <TouchableOpacity
                    key={num}
                    style={[
                      styles.seatButton,
                      availableSeats === num.toString() && styles.seatButtonSelected
                    ]}
                    onPress={() => setAvailableSeats(num.toString())}
                  >
                    <Text style={[
                      styles.seatButtonText,
                      availableSeats === num.toString() && styles.seatButtonTextSelected
                    ]}>
                      {num}
                    </Text>
                  </TouchableOpacity>
                ))}
              </View>
            </View>
          </View>

          {/* Notes */}
          <View style={styles.section}>
            <Text style={styles.sectionTitle}>Additional Notes</Text>
            <Input
              placeholder="Add any notes for passengers (optional)"
              value={notes}
              onChangeText={setNotes}
              multiline
              style={styles.notesInput}
            />
          </View>

          {/* Summary */}
          {(pickupLocation && dropoffLocation) && (
            <View style={styles.summarySection}>
              <Text style={styles.summaryTitle}>Ride Summary</Text>
              <View style={styles.summaryRow}>
                <Text style={styles.summaryLabel}>Route:</Text>
                <Text style={styles.summaryValue} numberOfLines={2}>
                  {pickupLocation.name} → {dropoffLocation.name}
                </Text>
              </View>
              <View style={styles.summaryRow}>
                <Text style={styles.summaryLabel}>Date & Time:</Text>
                <Text style={styles.summaryValue}>
                  {selectedDate || 'Today'} at {selectedTime || 'Now'}
                </Text>
              </View>
              <View style={styles.summaryRow}>
                <Text style={styles.summaryLabel}>Cab Type:</Text>
                <Text style={styles.summaryValue}>{cabType.charAt(0).toUpperCase() + cabType.slice(1)}</Text>
              </View>
              <View style={styles.summaryRow}>
                <Text style={styles.summaryLabel}>Available Seats:</Text>
                <Text style={styles.summaryValue}>{availableSeats}</Text>
              </View>
              <View style={[styles.summaryRow, styles.estimatedFareRow]}>
                <Text style={styles.estimatedFareLabel}>Estimated Fare</Text>
                <Text style={styles.estimatedFareValue}>₹{estimateFare()}</Text>
              </View>
            </View>
          )}

          <Button
            title="Create Ride"
            onPress={handleCreateRide}
            loading={loading}
            disabled={!pickupLocation || !dropoffLocation}
            style={styles.createButton}
          />
        </View>
      </ScrollView>

      {/* Pickup Location Modal */}
      <Modal
        visible={showPickupModal}
        animationType="slide"
        presentationStyle="pageSheet"
      >
        <View style={styles.modalContainer}>
          <View style={styles.modalHeader}>
            <Text style={styles.modalTitle}>Select Pickup Location</Text>
            <TouchableOpacity onPress={() => setShowPickupModal(false)}>
              <Text style={styles.modalClose}>×</Text>
            </TouchableOpacity>
          </View>
          <Input
            placeholder="Search pickup location..."
            value={pickupSearch}
            onChangeText={setPickupSearch}
            style={styles.searchInput}
          />
          <FlatList
            data={filteredPickupLocations}
            renderItem={({ item }) => renderLocationItem(item, 'pickup')}
            keyExtractor={(item) => item.id}
            style={styles.locationList}
          />
        </View>
      </Modal>

      {/* Dropoff Location Modal */}
      <Modal
        visible={showDropoffModal}
        animationType="slide"
        presentationStyle="pageSheet"
      >
        <View style={styles.modalContainer}>
          <View style={styles.modalHeader}>
            <Text style={styles.modalTitle}>Select Dropoff Location</Text>
            <TouchableOpacity onPress={() => setShowDropoffModal(false)}>
              <Text style={styles.modalClose}>×</Text>
            </TouchableOpacity>
          </View>
          <Input
            placeholder="Search dropoff location..."
            value={dropoffSearch}
            onChangeText={setDropoffSearch}
            style={styles.searchInput}
          />
          <FlatList
            data={filteredDropoffLocations}
            renderItem={({ item }) => renderLocationItem(item, 'dropoff')}
            keyExtractor={(item) => item.id}
            style={styles.locationList}
          />
        </View>
      </Modal>
    </KeyboardAvoidingView>
  );
}

